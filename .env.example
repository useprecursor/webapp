# Precursor frontend environment. Copy to .env (or .env.local) and fill in.

# Privy: sign-in for the Console, Portfolio and account pages.
# Both values are in the Privy dashboard under App settings. The secret stays on the server.
# Optional: turn on identity tokens (User management, Authentication) so the server can read
# linked wallets without Privy's rate-limited user lookup.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Supabase: where every company, share class, holding and event is stored.
# Run supabase/schema.sql in the SQL editor once before starting the app.
# The server reads and writes with the service-role key; the browser never talks to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret service-role key (sb_secret_... or the legacy service_role JWT), from Project Settings, API keys.
SUPABASE_SERVICE_ROLE_KEY=

# Robinhood Chain testnet. Mainnet is chain 4663 at https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain Testnet
# Public RPC, rate-limited. Events are recorded at its latest block.
NEXT_PUBLIC_CHAIN_RPC=https://rpc.testnet.chain.robinhood.com
# Block explorer used for transaction and address links.
NEXT_PUBLIC_CHAIN_EXPLORER=https://robinhoodchain.blockscout.com
